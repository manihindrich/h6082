# Local settings of h6082 — copy to .env and edit. Never commit .env (it is in .gitignore).

# UID:GID owning the content/ folder (command `id`)
H6082_UID=1000
H6082_GID=1000

# where the page listens; 127.0.0.1 = this machine only
H6082_BIND=127.0.0.1
H6082_PORT=8088

# password for the web editor and writes (HTTP Basic); empty = editor without a password
# generate e.g.: openssl rand -base64 24
H6082_EDITOR_USER=h6082
H6082_EDITOR_PASSWORD=

# extra hostnames the page answers to (comma separated), e.g. a domain behind a reverse proxy
H6082_ALLOWED_HOSTS=

# an empty directory on the host root disk for the {{sys}} disk (e.g. /var/empty)
H6082_DISK_ROOT=/var/empty
